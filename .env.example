# ==============================================================================
# CloudCart - Global Environment Variables Template
# Copy this file to .env and customize values for production deployment
# DO NOT commit actual .env files containing production secrets to Git!
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=5000

# Database Configuration (Docker service hostname: mongodb)
MONGO_URI=mongodb://mongodb:27017/cloudcart

# JWT Authentication Secret & Lifespan
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRES_IN=7d

# Frontend Host URL for CORS
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Default Seed Administrator Account Credentials
ADMIN_NAME=CloudCart Administrator
ADMIN_EMAIL=admin@cloudcart.com
ADMIN_PASSWORD=Admin@123

# Default Seed Customer Account Credentials
DEMO_CUSTOMER_EMAIL=customer@cloudcart.com
DEMO_CUSTOMER_PASSWORD=Customer@123

# Grafana Dashboard Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
